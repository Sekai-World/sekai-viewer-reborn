{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergePatch",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm", "mise"],
      "matchDepNames": ["pnpm"],
      "allowedVersions": "11.13.0"
    },
    {
      "matchManagers": ["npm", "mise"],
      "matchDepNames": ["node"],
      "allowedVersions": ">=24 <25"
    },
    {
      "matchManagers": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["npm"],
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "matchManagers": ["npm"],
      "matchDepNames": ["@typescript/native"],
      "allowedVersions": ">=7.0.0"
    },
    {
      "description": "pixi.js v8 is blocked: @sekai-world/pixi-live2d-display-mulmotion@0.5.1 peer-depends on pixi.js ^7 and imports @pixi/* scoped packages that no longer exist in v8. Re-enable majors when the Live2D plugin ecosystem supports v8.",
      "matchManagers": ["npm"],
      "matchDepNames": ["pixi.js"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "platformAutomerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": false
    }
  ]
}

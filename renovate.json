{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm", "mise"],
      "matchDepNames": ["pnpm"],
      "allowedVersions": "11.8.0"
    },
    {
      "matchManagers": ["npm", "mise"],
      "matchDepNames": ["node"],
      "allowedVersions": ">=24 <25"
    },
    {
      "matchManagers": ["npm"],
      "minimumReleaseAge": "1 day"
    }
  ]
}

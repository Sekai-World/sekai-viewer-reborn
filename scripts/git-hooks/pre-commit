#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v pnpm >/dev/null 2>&1; then
  printf '%s\n' 'pre-commit: pnpm is required. Run `mise install` or install pnpm, then try again.' >&2
  exit 1
fi

format_files=()
staged_files=()
while IFS= read -r -d '' file; do
  format_files+=("$file")
  case "$file" in
    apps/*/src/*|packages/*/src/*|packages/*/scripts/*|scripts/*)
      case "$file" in
        *.gen.ts) ;;
        *.js|*.mjs|*.ts|*.svelte)
          staged_files+=("$file")
          ;;
      esac
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z --)

if ((${#format_files[@]} > 0)); then
  pnpm exec prettier --check --ignore-unknown -- "${format_files[@]}"
fi

if ((${#staged_files[@]} > 0)); then
  pnpm exec eslint -- "${staged_files[@]}"
fi

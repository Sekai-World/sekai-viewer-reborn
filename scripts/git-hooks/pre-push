#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v pnpm >/dev/null 2>&1; then
  printf '%s\n' 'pre-push: pnpm is required. Run `mise install` or install pnpm, then try again.' >&2
  exit 1
fi

status_output="$(git status --porcelain=v1 --untracked-files=all)"
if [[ -n "$status_output" ]]; then
  printf '%s\n' 'pre-push: the worktree must be clean before pushing, including ordinary untracked files.' >&2
  printf '%s\n' 'Commit or stash the changes, then retry the push.' >&2
  printf '%s\n' "$status_output" >&2
  exit 1
fi

# The branch is compared with the default branch, so only the packages it changes (and their
# dependents) are validated. CI runs the full `pnpm verify:ci` sequence, including the build, so
# this hook never runs the whole repository's tests; a change to root configuration is covered by
# the Prettier check on the changed files here and by CI.
default_ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || printf '%s' origin/main)"
if ! base="$(git merge-base HEAD "$default_ref" 2>/dev/null)"; then
  printf '%s\n' "pre-push: no merge base with $default_ref; checking formatting and i18n only. CI runs the full gate." >&2
  pnpm format:check
  pnpm i18n:check
  exit 0
fi

changed_files=()
while IFS= read -r -d '' file; do
  changed_files+=("$file")
done < <(git diff --name-only --diff-filter=ACMR -z "$base" HEAD --)

printf '%s\n' "pre-push: validating changes since $default_ref (format:check on changed files; test, lint and check on affected packages; i18n:check). CI runs the full gate and the production build." >&2
if ((${#changed_files[@]} > 0)); then
  pnpm exec prettier --check --ignore-unknown -- "${changed_files[@]}"
fi
# One Turbo run overlaps the three tasks; the concurrency cap keeps the parallel ESLint, Vitest and
# svelte-check processes from starving each other (the default of 10 timed ESLint workers out).
TURBO_SCM_BASE="$base" TURBO_SCM_HEAD=HEAD pnpm exec turbo run test lint check --affected --concurrency=4 --output-logs=errors-only
pnpm i18n:check

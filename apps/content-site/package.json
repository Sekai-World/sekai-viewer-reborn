{
  "name": "@apps/content-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4101",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 5101",
    "test": "svelte-kit sync && vitest run --config ./vitest.config.ts",
    "test:coverage": "pnpm --filter @apps/account-site exec svelte-kit sync && pnpm --filter @apps/media-lab-site exec svelte-kit sync && svelte-kit sync && vitest run --config ./vitest.config.ts --coverage && node ../../scripts/coverage/normalize-lcov.mjs coverage/lcov.info apps/content-site",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "eslint src --ext .ts,.svelte"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.1",
    "@platform/auth-client": "workspace:*",
    "@platform/i18n-runtime": "workspace:*",
    "@platform/i18n-source": "workspace:*",
    "@platform/sekai-master-api-sdk": "workspace:*",
    "@platform/ui-shell": "workspace:*",
    "@platform/ui-tokens": "workspace:*",
    "taglib-wasm": "^1.2.2"
  },
  "devDependencies": {
    "@iconify-icons/mdi": "^1.2.48",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "daisyui": "^5.5.20",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16"
  }
}

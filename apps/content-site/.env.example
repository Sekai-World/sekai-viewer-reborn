# Copy this file to .env.development / .env.test / .env.production and adjust values per environment.

# Master API base URL (required by server load functions)
SEKAI_MASTER_API_BASE_URL=http://localhost:8080/api/v1

# Remote asset base URL (required by client asset URL helpers)
# Development usually uses /storage with Vite proxy.
PUBLIC_REMOTE_ASSET_BASE_URL=/storage

# i18n dictionary base URL (svelte-i18n CDN, flat JSON served from GitHub Pages)
PUBLIC_SEKAI_I18N_BASE_URL=https://sekai-world.github.io/sekai-i18n-reborn

# Vite dev proxy for remote assets (used in development mode)
VITE_REMOTE_ASSET_PROXY_ENABLED=true
VITE_REMOTE_ASSET_PROXY_PATH=/storage
VITE_REMOTE_ASSET_PROXY_TARGET=https://storage.sekai.best

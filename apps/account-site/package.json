{
  "name": "@apps/account-site",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4104",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 5104",
    "test": "svelte-kit sync && vitest run --config ./vitest.config.ts",
    "test:coverage": "svelte-kit sync && vitest run --config ./vitest.config.ts --coverage && node ../../scripts/lcov/normalize-lcov.mjs coverage/lcov.info apps/account-site",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "eslint src --ext .ts,.svelte"
  },
  "dependencies": {
    "@platform/auth-client": "workspace:*",
    "@platform/sekai-master-api-sdk": "workspace:*",
    "@platform/ui-shell": "workspace:*",
    "@platform/ui-tokens": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "daisyui": "^5.5.20",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0"
  }
}

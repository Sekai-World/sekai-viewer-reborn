{
  "name": "@apps/tools-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4102",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 5102",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "pnpm --filter '@apps/*' exec svelte-kit sync && vitest run --config ./vitest.config.ts --coverage && node ../../scripts/lcov/normalize-lcov.mjs coverage/lcov.info apps/tools-site",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src --ext .ts,.svelte"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.1",
    "@platform/auth-client": "workspace:*",
    "@platform/i18n-runtime": "workspace:*",
    "@platform/i18n-source": "workspace:*",
    "@platform/sekai-api-sdk": "workspace:*",
    "@platform/sekai-master-api-sdk": "workspace:*",
    "@platform/ui-shell": "workspace:*",
    "@platform/ui-tokens": "workspace:*",
    "layerchart": "^2.2.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@iconify-icons/mdi": "^2.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^5.0.0",
    "daisyui": "^5.5.20",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}

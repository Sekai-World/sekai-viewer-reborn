{
  "name": "@apps/tools-site",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4102",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 5102",
    "test": "svelte-kit sync && vitest run --config ./vitest.config.ts",
    "test:coverage": "pnpm --filter @apps/account-site exec svelte-kit sync && pnpm --filter @apps/content-site exec svelte-kit sync && pnpm --filter @apps/media-lab-site exec svelte-kit sync && svelte-kit sync && vitest run --config ./vitest.config.ts --coverage && node ../../scripts/lcov/normalize-lcov.mjs coverage/lcov.info apps/tools-site",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "eslint src --ext .ts,.svelte"
  },
  "dependencies": {
    "@platform/auth-client": "workspace:*",
    "@platform/i18n-runtime": "workspace:*",
    "@platform/i18n-source": "workspace:*",
    "@platform/sekai-api-sdk": "workspace:*",
    "@platform/sekai-master-api-sdk": "workspace:*",
    "@platform/ui-shell": "workspace:*",
    "@platform/ui-tokens": "workspace:*",
    "@iconify/svelte": "^5.2.1",
    "layerchart": "^2.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@iconify-icons/mdi": "^1.2.48",
    "@types/d3": "^7.4.3",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^25.9.1",
    "daisyui": "^5.5.20",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0"
  }
}

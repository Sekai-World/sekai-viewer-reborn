# Copy to .env.development (or another local environment file) and adjust for your local services.

# Public sekai-api base URL required by server-side event tracker ranking loaders.
SEKAI_API_BASE_URL=http://localhost:3000

# Master API base URL required by server-side current-event comparison loaders.
SEKAI_MASTER_API_BASE_URL=http://localhost:18080/api/v1

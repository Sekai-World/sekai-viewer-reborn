{
  "name": "@platform/live2d-story-player",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./pixi": {
      "types": "./src/adapters/pixi/index.ts",
      "import": "./src/adapters/pixi/index.ts",
      "default": "./src/adapters/pixi/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage && node ../../scripts/lcov/normalize-lcov.mjs coverage/lcov.info packages/live2d-story-player"
  },
  "dependencies": {
    "@sekai-world/pixi-live2d-display-mulmotion": "^0.5.1",
    "howler": "^2.2.4",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^25.9.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}

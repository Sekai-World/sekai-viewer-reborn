{
  "name": "@platform/i18n-runtime",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage && node ../../scripts/lcov/normalize-lcov.mjs coverage/lcov.info packages/i18n-runtime"
  },
  "dependencies": {
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "svelte": "^5.56.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}

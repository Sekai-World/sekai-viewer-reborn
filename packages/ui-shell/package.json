{
  "name": "@platform/ui-shell",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "pnpm --filter '@apps/*' exec svelte-kit sync",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage && node ../../scripts/coverage/normalize-lcov.mjs coverage/lcov.info packages/ui-shell",
    "lint": "eslint src --ext .ts,.svelte",
    "check": "pnpm exec svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./image-retry": {
      "types": "./src/image-retry/index.ts",
      "svelte": "./src/image-retry/index.ts",
      "default": "./src/image-retry/index.ts"
    }
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.1",
    "howler": "^2.2.4"
  },
  "devDependencies": {
    "@testing-library/svelte": "^5.4.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^25.9.5",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "vite": "8.2.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}

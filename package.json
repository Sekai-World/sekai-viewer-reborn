{
  "name": "multisite-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "check": "turbo check",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "release:version": "changeset version",
    "release:tag": "changeset tag",
    "release:github": "node ./scripts/release/publish-workspace-releases.mjs",
    "release:publish": "node ./scripts/release/publish-workspace-releases.mjs",
    "release": "pnpm release:version && pnpm release:tag",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-svelte": "^3.16.0",
    "globals": "^17.4.0",
    "prettier": "^3.5.2",
    "svelte-eslint-parser": "^1.6.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0"
  }
}
